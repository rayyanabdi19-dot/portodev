rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'rayyan.abdi19@gmail.com' ||
        (request.auth.token.email_verified == true && request.auth.token.email == 'admin@delvandriawan.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidMessage(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 3000;
    }

    // Connection health check & probe document
    match /test/{docId} {
      allow get: if true;
    }

    // Contact messages collection: visitors can submit, only admin can view/manage
    match /messages/{messageId} {
      allow create: if isValidId(messageId) && isValidMessage(incoming());
      allow get, list: if isAdmin();
      allow update, delete: if isAdmin() && isValidId(messageId);
    }

    // Portfolio master content: public can view, only admin can edit
    match /portfolio/{docId} {
      allow get: if isValidId(docId);
      allow list: if true;
      allow create, update, delete: if isAdmin() && isValidId(docId);
    }

    // Portfolio projects: public can view, only admin can modify
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(projectId);
    }

    // Analytics counters (page views & CV downloads)
    match /analytics/{docId} {
      allow get: if isValidId(docId);
      allow create, update: if isValidId(docId) &&
                               incoming().views_count is number &&
                               incoming().downloads_count is number;
      allow delete: if isAdmin() && isValidId(docId);
    }

    // Admin whitelist collection
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if isAdmin();
    }
  }
}
